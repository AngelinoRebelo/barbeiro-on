generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BARBER
  CLIENT
}

enum UserStatus {
  PENDING_EMAIL
  ACTIVE
  SUSPENDED
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

enum ServiceCategory {
  HAIR
  BEARD
  COMBO
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  DONE
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  PIX
  MERCADOPAGO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentKind {
  SERVICE
  SUBSCRIPTION
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role
  status        UserStatus @default(PENDING_EMAIL)
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  shopId        String?
  shop          BarberProfile? @relation("ShopMembers", fields: [shopId], references: [id], onDelete: SetNull)
  barberProfile BarberProfile?
  tokens        AuthToken[]
  clientsOwned  BarberClient[] @relation("BarberClients")
  clientLinks   BarberClient[] @relation("ClientUser")
  appointments  Appointment[]  @relation("ClientAppointments")
  payments      Payment[]      @relation("ClientPayments")
  auditLogs     AuditLog[]
  supportTickets SupportTicket[]

  @@index([shopId])
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
}

model BarberProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName    String
  slug        String     @unique
  bio         String     @default("")
  address     String     @default("")
  city        String     @default("São Paulo")
  approved    Boolean    @default(true)
  openTime    String     @default("09:00")
  closeTime   String     @default("20:00")
  workDays    Int[]      @default([1, 2, 3, 4, 5, 6])
  pixKey             String             @default("")
  pixKeyType         PixKeyType         @default(RANDOM)
  mpPublicKey        String             @default("")
  mpAccessEnc        String             @default("")
  planId             String?
  plan               Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  billingCents       Int?
  subscriptionStatus SubscriptionStatus @default(PENDING)
  accessUntil        DateTime?
  features           Json               @default("{\"agenda\":true,\"clients\":true,\"services\":true,\"pix\":true,\"mercadopago\":true,\"publicShop\":true}")
  brandAt            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members      User[]          @relation("ShopMembers")
  services     Service[]
  clients      BarberClient[]
  appointments Appointment[]
  payments     Payment[]
  availability AvailabilitySlot[]
  brand        ShopBrand?
}

model ShopBrand {
  barberId  String        @id
  barber    BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  updatedAt DateTime      @updatedAt
}

model Plan {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String       @default("")
  priceCents  Int
  interval    PlanInterval @default(MONTHLY)
  durationDays Int         @default(30)
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
  features    Json         @default("{\"agenda\":true,\"clients\":true,\"services\":true,\"pix\":true,\"mercadopago\":true,\"publicShop\":true}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  barbers     BarberProfile[]
}

model PlatformSettings {
  id          String     @id @default("platform")
  pixKey      String     @default("")
  pixKeyType  PixKeyType @default(RANDOM)
  mpPublicKey String     @default("")
  mpAccessEnc String     @default("")
  trialDays   Int        @default(30)
  updatedAt   DateTime   @updatedAt
}

model AvailabilitySlot {
  id        String        @id @default(cuid())
  barberId  String
  barber    BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  createdAt DateTime      @default(now())

  @@unique([barberId, startsAt])
  @@index([barberId, startsAt])
}

model Service {
  id           String          @id @default(cuid())
  barberId     String
  barber       BarberProfile   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  name         String
  description  String          @default("")
  category     ServiceCategory @default(HAIR)
  durationMin  Int             @default(30)
  priceCents   Int
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  appointments Appointment[]
}

model BarberClient {
  id          String        @id @default(cuid())
  barberId    String
  barber      BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?         @relation("ClientUser", fields: [userId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?         @relation("BarberClients", fields: [createdById], references: [id], onDelete: SetNull)
  name        String
  phone       String        @default("")
  email       String        @default("")
  notes       String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  appointments Appointment[]
  payments     Payment[]

  @@index([barberId, email])
  @@index([barberId, phone])
}

model Appointment {
  id        String            @id @default(cuid())
  barberId  String
  barber    BarberProfile     @relation(fields: [barberId], references: [id], onDelete: Cascade)
  clientId  String
  client    BarberClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?             @relation("ClientAppointments", fields: [userId], references: [id], onDelete: SetNull)
  serviceId String
  service   Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  startsAt  DateTime
  endsAt    DateTime
  status    AppointmentStatus @default(SCHEDULED)
  notes     String            @default("")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  payments  Payment[]

  @@index([barberId, startsAt])
}

model Payment {
  id             String         @id @default(cuid())
  barberId       String
  barber         BarberProfile  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clientId       String?
  client         BarberClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?          @relation("ClientPayments", fields: [userId], references: [id], onDelete: SetNull)
  amountCents    Int
  method         PaymentMethod
  kind           PaymentKind    @default(SERVICE)
  status         PaymentStatus  @default(PENDING)
  pixPayload     String?
  pixTxid        String?
  mpPreferenceId String?
  mpInitPoint    String?
  mpPaymentId    String?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([barberId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String   @default("")
  meta      Json?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String   @default("")
  email     String   @default("")
  role      String   @default("")
  shopSlug  String   @default("")
  body      String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
